rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMembro(casaId) {
      return request.auth != null &&
        request.auth.token.email.lower() in
          get(/databases/$(database)/documents/casas/$(casaId)).data.emailsAtivos;
    }

    // O fechamento de um cartao e privado por pessoa: o Marcos nao pode ler
    // o dia da Silvia nem ela o dele. So funciona porque cada um mora no
    // proprio documento (id = membroId) -- Firestore nao esconde campo
    // dentro de um documento que a outra pessoa ja tem acesso de leitura.
    function souEu(casaId, membroId) {
      let casa = get(/databases/$(database)/documents/casas/$(casaId)).data;
      return membroId in casa.membros &&
        casa.membros[membroId].email.lower() == request.auth.token.email.lower();
    }

    match /casas/{casaId} {
      allow read: if isMembro(casaId);
      allow write: if false;

      match /cartoes/{cartaoId}/fechamentos/{membroId} {
        allow read, write: if isMembro(casaId) && souEu(casaId, membroId);
      }

      match /{colecao}/{doc} {
        allow read, write: if isMembro(casaId);
      }
    }

    match /indiceEmail/{email} {
      allow read, write: if false;
    }

    match /removidosPendentes/{doc} {
      allow read, write: if false;
    }
  }
}
